<!-- Mac check of the on-device shader compiler (ios/shaders/RuntimeShaders.cs) against the Python pipeline's output. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>RuntimeShadersCheck</StartupObject>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>CS7022</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Graphics.Shader/Ryujinx.Graphics.Shader.csproj" />
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Common/Ryujinx.Common.csproj" />
    <Compile Include="../../work/build/runtime-shaders/Program.cs" />
    <Compile Include="../../ios/shaders/RuntimeShaders.cs" />
    <Compile Include="Check.cs" />
  </ItemGroup>
</Project>
